# Reference only. Worker vars belong in gitignored wrangler.jsonc; secrets via Wrangler.
PUBLIC_HOST=relou.jjmowlab.com
ADMIN_HOST=admin.relou.jjmowlab.com
PUBLIC_SITE_URL=https://relou.jjmowlab.com
ENVIRONMENT=production

# Public (safe to show on client)
TURNSTILE_SITE_KEY=
SUPPORT_EMAIL=

# Server-only secrets: npx wrangler secret put <NAME>
# TURNSTILE_SECRET_KEY=
# RATE_HASH_PEPPER=
# CF_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
# CF_ACCESS_AUD=<admin-application-audience>
# ADMIN_EMAIL_ALLOWLIST=<exact-admin-email>

# Gmail SMTP (owner-approved transport change), results ONLY
MAIL_PROVIDER=gmail_smtp
GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD is a Worker secret, never a Vite variable.
EMAIL_FROM=
EMAIL_DRY_RUN=true
EMAIL_ENABLED=false

# Round quality threshold is stored in D1 per round, default 55.
# No participant login, school Email allowlist, OTP or magic link.
