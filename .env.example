# Public canonical URL (no trailing slash)
PUBLIC_SITE_URL=https://relou.jjmowlab.com
ENVIRONMENT=local

# Confirm campus student email domain rules before production.
# JSON parsed by backend only; fake/unverified domains must NOT be allowed in production.
SCHOOL_EMAIL_DOMAINS_JSON={"NYCU":[],"NTHU":[]}

# Runtime secrets: use .dev.vars locally and Wrangler secrets remotely, not this file.
# SESSION_SECRET= (generate strong random secret via secrets manager)
# ADMIN_TOKEN= (high entropy operator-only)
# TURNSTILE_SECRET_KEY= (server-only)

# Cloudflare Turnstile (public site key)
VITE_TURNSTILE_SITE_KEY=

# Cloudflare D1: binding DB configured in wrangler.jsonc once real database ID exists.
# Cloudflare Email Service: send_email binding EMAIL once sender domain is onboarded.
EMAIL_FROM=
EMAIL_DRY_RUN=true
EMAIL_BATCH_SIZE=10
EMAIL_SEND_RATE_PER_MINUTE=10

# Matching
MIN_PAIR_SCORE=55
MATCHING_SEED=20261029
EMBEDDINGS_ENABLED=false
