# Relou: one-page, one-submit, no account / email verification
# Production canonical domain (target only; not deployed yet)
PUBLIC_SITE_URL=https://relou.jjmowlab.com
ENVIRONMENT=local

# Cloudflare Wrangler binding DB in wrangler.jsonc after provisioning D1.
# No login keys, OTP / magic link, auth callbacks or student-email domain allowlist.
# School NYCU or NTHU is self-reported, and any valid email may be used.

# Turnstile (public site key is safe to embed in the client)
VITE_TURNSTILE_SITE_KEY=
# Secret MUST be configured with Wrangler secrets, not stored here:
# TURNSTILE_SECRET_KEY=
# ADMIN_TOKEN= (operator-only; prefer Cloudflare Access)

# Cloudflare Email Service native binding. Only result notifications, no signup messages.
EMAIL_FROM=
EMAIL_DRY_RUN=true
EMAIL_BATCH_SIZE=10
EMAIL_SEND_RATE_PER_MINUTE=10

# Matching
MIN_PAIR_SCORE=55
MATCHING_SEED=20261029
EMBEDDINGS_ENABLED=false
