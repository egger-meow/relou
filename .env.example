# Example only. Never commit real credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Workers production: NEXT_PUBLIC_SITE_URL=https://relou.jjmowlab.com
# Supabase Auth Site URL: https://relou.jjmowlab.com
# Auth redirect allowlist: https://relou.jjmowlab.com/<your-actual-auth-callback>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Verified student email domain allowlist (configure after confirmation with schools)
SCHOOL_EMAIL_DOMAINS_JSON={"NYCU":[],"NTHU":[]}

# Matching: deterministic by default
MIN_PAIR_SCORE=55
MATCHING_SEED=20261029
EMBEDDINGS_ENABLED=false

# SMTP transactional provider; configure TLS as appropriate (port 465 SSL / port 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_DRY_RUN=true
EMAIL_BATCH_SIZE=10
EMAIL_SEND_RATE_PER_MINUTE=10

# Server-only admin token for operator tools, not a public client value
ADMIN_TOKEN=

# Antibot optional; production must deploy equivalent rate limits / abuse protections
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
