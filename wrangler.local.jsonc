{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relou-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "relou-local", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "1002", "simple": { "limit": 4, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_HOST": "localhost", "ADMIN_HOST": "admin.relou.jjmowlab.com", "ENVIRONMENT": "local",
    "PUBLIC_SITE_URL": "http://localhost:8787", "EMAIL_DRY_RUN": "true", "EMAIL_ENABLED": "false",
    "SUPPORT_EMAIL": "synthetic-support@example.invalid",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
    "RATE_HASH_PEPPER": "local-synthetic-only-never-use-in-production"
  }
}
