{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relou",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "relou.jjmowlab.com", "custom_domain": true },
    { "pattern": "admin.relou.jjmowlab.com", "custom_domain": true }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "relou",
    "database_id": "__REAL_D1_DATABASE_ID__",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "1002", "simple": { "limit": 4, "period": 60 } }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "PUBLIC_HOST": "relou.jjmowlab.com",
    "ADMIN_HOST": "admin.relou.jjmowlab.com",
    "PUBLIC_SITE_URL": "https://relou.jjmowlab.com",
    "EMAIL_DRY_RUN": "true",
    "EMAIL_ENABLED": "false",
    "EMAIL_FROM": "",
    "TURNSTILE_SITE_KEY": "",
    "SUPPORT_EMAIL": "",
    "ENVIRONMENT": "production"
  }
}
